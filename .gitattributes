* text=auto eol=lf
# Windows scripts: cmd.exe misparses LF-only batch files; keep both in CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
# A PDF's cross-reference table counts bytes (tests/fixtures/zjazdy.pdf): never a conversion of line ends.
*.pdf binary
