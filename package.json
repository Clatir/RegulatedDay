{
  "name": "regulated-day",
  "productName": "Regulated Day",
  "version": "0.14.0",
  "description": "Regulated Day – planowanie dnia z modelem energii i regeneracji",
  "private": true,
  "author": "Regulated Day",
  "license": "UNLICENSED",
  "main": "./out/main/start.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/check-node.mjs",
    "build": "electron-vite build",
    "prestart": "node scripts/check-node.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "node scripts/check-code.mjs",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build:helper": "node scripts/build-helper.mjs",
    "dist:win": "npm run build && npm run build:helper && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && npm run build:helper && electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "luxon": "3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
